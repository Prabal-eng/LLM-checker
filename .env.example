# Environment Variables for Excel AI QA Pipeline
# Copy this file to .env and fill in your values
# (the trained ML model works offline — no API keys required for default mode)

# ─── AI Detection API Keys (only needed if switching detector provider) ───────
# Used with: python -m src.cli audit file.xlsx --provider gptzero --api-key $GPTZERO_API_KEY
GPTZERO_API_KEY=

# Used with: python -m src.cli audit file.xlsx --provider originality --api-key $ORIGINALITY_API_KEY
ORIGINALITY_API_KEY=

# ─── Airtable Integration (optional — for team review queue sync) ─────────────
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=AI Review Queue

# ─── API Server Settings ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (use * for local dev only)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Maximum upload file size in megabytes
MAX_UPLOAD_MB=50
